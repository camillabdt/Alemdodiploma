function criarFormularioAlumniViewLimpo() {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const props = PropertiesService.getScriptProperties();
    const chave = 'ALUMNI_FORM_BASE_AUTOMATICA_PPC_V3';
    const idExistente = props.getProperty(chave + '_ID');

    if (idExistente) {
      const existente = FormApp.openById(idExistente);
      Logger.log('Rascunho existente: ' + existente.getEditUrl());
      if (props.getProperty(chave + '_COMPLETE') !== 'true') {
        throw new Error(
          'A criação anterior ficou parcial. Abra o endereço registrado para revisar. ' +
          'O script não apagará nem duplicará esse formulário.'
        );
      }
      return existente.getEditUrl();
    }

    const form = FormApp.create(SPEC.title, false);
    props.setProperty(chave + '_ID', form.getId());
    props.setProperty(chave + '_COMPLETE', 'false');
    Logger.log('Endereço do rascunho: ' + form.getEditUrl());

    const descricao = [
      BIO,
      "Primeiro, responda sobre o curso; depois, experimente a plataforma e avalie sua experiência. " +
      "Tempo estimado: 15 a 20 minutos, a conferir no pré-teste."
    ];
    if (INFORMACOES_GUARDA.trim()) descricao.push(INFORMACOES_GUARDA.trim());
    form.setCollectEmail(false)
      .setProgressBar(true)
      .setShuffleQuestions(false)
      .setPublishingSummary(false)
      .setDescription(descricao.join('\n\n'))
      .setConfirmationMessage('Agradecemos sua participação.');

    form.addSectionHeaderItem()
      .setTitle('Termo de Consentimento Livre e Esclarecido — TCLE')
      .setHelpText(TCLE);

    const consentimento = form.addMultipleChoiceItem()
      .setTitle('Você concorda em participar voluntariamente?')
      .setRequired(true);

    const perfil = form.addPageBreakItem()
      .setTitle('1. Sobre o curso')
      .setHelpText(
        'Responda sobre o curso com o qual tem maior vínculo. ' +
        'Apenas as questões indicadas com asterisco são obrigatórias.'
      );
    ['P0INST', 'P0CURSO', 'P1', 'P2', 'P3'].forEach(id => adicionarPergunta(form, obterPergunta(id)));
    const acompanhamento = adicionarPergunta(form, obterPergunta('D1'));

    const praticas = form.addPageBreakItem()
      .setTitle('2. Acompanhamento dos egressos');
    adicionarSecao(form, 'praticas');

    const necessidades = form.addPageBreakItem()
      .setTitle('3. Dificuldades e necessidades');
    adicionarSecao(form, 'necessidades');

    const endereco = URL_FERRAMENTA.trim()
      ? 'em ' + URL_FERRAMENTA.trim()
      : 'no endereço fornecido pela pesquisadora';
    form.addPageBreakItem()
      .setTitle('4. Experimente a Alumni View')
      .setHelpText(
        'Abra a plataforma ' + endereco + '. ' +
        'A base do estudo será carregada automaticamente. Não é necessário selecionar ou enviar um arquivo. ' +
        'Faça as tarefas na ordem; se não conseguir, registre e prossiga. ' +
        'Consulte as orientações disponíveis na plataforma. ' +
        'A origem geográfica representa nascimento.\n\n' +
        SPEC.tasks.map(tarefa => tarefa[0] + ': ' + tarefa[1]).join('\n\n')
      );
    const utilizou = form.addMultipleChoiceItem()
      .setTitle('Você conseguiu experimentar a Alumni View?')
      .setRequired(true);

    const experiencia = form.addPageBreakItem()
      .setTitle('5. Sua experiência com a plataforma');
    form.addGridItem()
      .setTitle('Como foi a realização das tarefas?')
      .setRows(SPEC.tasks.map(tarefa => tarefa[0] + ': ' + tarefa[1]))
      .setColumns(SPEC.task_options)
      .setRequired(false);

    form.addParagraphTextItem()
      .setTitle(
        'Caso não tenha conseguido utilizar a plataforma, ' +
        'informe os motivos no campo abaixo.'
      )
      .setRequired(false);

    adicionarEscala(form, 'Utilidade percebida',
      SPEC.items.filter(q => q.id.startsWith('UP')));
    adicionarEscala(form, 'Facilidade de uso percebida',
      SPEC.items.filter(q => q.id.startsWith('FUP')));

    const visualizou = form.addMultipleChoiceItem()
      .setTitle('Você conseguiu visualizar resultados no Laboratório XAI?')
      .setRequired(true);

    const xai = form.addPageBreakItem()
      .setTitle('6. Explicações do XAI')
      .setHelpText(
        'Avalie os resultados que conseguiu visualizar. ' +
        'Nas perguntas abertas, use suas palavras; ' +
        'se não conseguiu interpretar, pode informar isso.'
      );
    adicionarEscala(form, 'Avaliação das explicações',
      SPEC.items.filter(q => q.id.startsWith('XP')));

    const sugestoes = form.addPageBreakItem()
      .setTitle('7. Uso futuro e sugestões');
    adicionarEscala(form, 'Intenção de uso',
      SPEC.items.filter(q => q.section === 'intencao'));
    adicionarSecao(form, 'ppc');
    adicionarSecao(form, 'complementares');

    const semUso = form.addPageBreakItem()
      .setTitle('Ferramenta não experimentada');
    adicionarSecao(form, 'sem_uso');

    // Direcionamentos por resposta.
    consentimento.setChoices([
      consentimento.createChoice('Sim, concordo', perfil),
      consentimento.createChoice('Não concordo', FormApp.PageNavigationType.SUBMIT)
    ]);
    acompanhamento.setChoices(obterPergunta('D1').options.map((opcao, indice) =>
      acompanhamento.createChoice(opcao, indice < 2 ? praticas : necessidades)
    ));
    utilizou.setChoices([
      utilizou.createChoice('Sim, mesmo que parcialmente', experiencia),
      utilizou.createChoice('Não', semUso)
    ]);
    visualizou.setChoices([
      visualizou.createChoice('Sim, visualizei resultados', xai),
      visualizou.createChoice('Acessei, mas não consegui visualizar resultados', sugestoes),
      visualizou.createChoice('Não acessei o laboratório', sugestoes)
    ]);

    // Em PageBreakItem, a navegação configura o fim da seção ANTERIOR.
    // Aqui encerra "Uso futuro e sugestões", sem exibir "Ferramenta não experimentada".
    // Quem chega diretamente a semUso pela resposta "Não" pode preencher N1 e enviar.
    semUso.setGoToPage(FormApp.PageNavigationType.SUBMIT);

    props.setProperty(chave + '_COMPLETE', 'true');
    Logger.log('Rascunho completo, não publicado: ' + form.getEditUrl());
    return form.getEditUrl();
  } finally {
    lock.releaseLock();
  }
}

function obterPergunta(id) {
  const pergunta = SPEC.items.find(q => q.id === id);
  if (!pergunta) throw new Error('Pergunta não encontrada: ' + id);
  return pergunta;
}

function adicionarSecao(form, secao) {
  SPEC.items.filter(q => q.section === secao)
    .forEach(q => adicionarPergunta(form, q));
}

function adicionarPergunta(form, pergunta) {
  let item;
  if (pergunta.kind === 'paragraph') {
    item = form.addParagraphTextItem();
  } else if (pergunta.kind === 'checks') {
    item = form.addCheckboxItem();
  } else if (pergunta.kind === 'text') {
    item = form.addTextItem();
  } else if (pergunta.kind === 'choice') {
    item = form.addMultipleChoiceItem();
  } else {
    throw new Error('Tipo de pergunta não reconhecido: ' + pergunta.kind);
  }

  if (pergunta.kind !== 'paragraph' && pergunta.kind !== 'text') {
    const opcoes = pergunta.native_other
      ? pergunta.options.slice(0, -1)
      : pergunta.options;
    item.setChoiceValues(opcoes);
    if (pergunta.native_other) item.showOtherOption(true);
  }
  item.setTitle(pergunta.title).setRequired(pergunta.required === true);
  if (pergunta.help) item.setHelpText(pergunta.help);
  return item;
}

function adicionarEscala(form, titulo, perguntas) {
  if (!perguntas.length) throw new Error('Escala sem afirmações: ' + titulo);
  return form.addGridItem()
    .setTitle(titulo)
    .setHelpText(SPEC.scale_help)
    .setRows(perguntas.map(q => q.title))
    .setColumns(SPEC.grid_columns)
    .setRequired(false);
}
